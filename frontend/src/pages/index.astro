---
import Layout from '../layouts/Layout.astro';
import { StarRating } from '../components/Interactive/StarRating.tsx';
import { TagManager } from '../components/Interactive/TagManager.tsx';
---

<Layout title="開発用プレビュー | MovieReview">
  <main class="max-w-4xl mx-auto p-6 space-y-10">
    <header class="py-8">
      <h1 class="text-4xl font-extrabold tracking-tight">Component Development</h1>
      <p class="text-gray-500 mt-2">developブランチで共通パーツを構築中</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <section class="space-y-4">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span>⭐</span> レビュー評価 (0.5刻み)
        </h2>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <StarRating client:load />
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span>🏷️</span> タグ管理 (CRUD対応)
        </h2>
        <TagManager client:load />
      </section>
    </div>
  </main>
</Layout>